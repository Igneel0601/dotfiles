{
  "include": ["/home/archVaibhav/.config/waybar/includes/includes.json"],

  "layer": "top",
  "position": "top",
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,

  "modules-left": ["group/left-pill", "custom/updates"],
  "modules-center": ["group/center-pill"],
  "modules-right": ["group/right-pill"],

  "group/left-pill": {
    "orientation": "horizontal",
    "modules": ["hyprland/workspaces", "custom/spotify"]
  },
  "group/center-pill": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "clock", "custom/cpuinfo", "custom/cpufan"]
  },
  "group/right-pill": {
    "orientation": "horizontal",
    "modules": ["tray", "power-profiles-daemon", "pulseaudio", "pulseaudio#microphone", "battery"]
  }
}

{
  "include": ["/home/archVaibhav/.config/waybar/includes/includes.json"],

  "layer": "top",
  "position": "top",
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,

  "modules-left": ["group/left-pill"],
  "modules-center": ["group/center-pill"],
  "modules-right": ["group/right-pill"],

  "group/left-pill": {
    "orientation": "horizontal",
    "modules": ["hyprland/workspaces"]
  },
  "group/center-pill": {
    "orientation": "horizontal",
    "modules": ["clock"]
  },
  "group/right-pill": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "pulseaudio#microphone", "battery"]
  }
}

{
  "battery": {
    "states": {
        "good": 100,
        "using": 80,
        "warning": 30,
        "critical": 20
      },
    "interval": 2,
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-good": "{icon} {capacity}%",
    "format-using": "{icon} {capacity}%",
    "format-warning": "{icon} {capacity}%",
    "format-critical": "! {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  }
}

(defpoll note_1_text :interval "0.5s" "cat '/home/archVaibhav/.config/eww/stickyNotes/notes/note_1.txt' 2>/dev/null || true")

(defwindow note_1
	:monitor 0
	:geometry (geometry
						:x "10px"
						:y "2%"
						:width "300px"
                        :height "300px"
						:anchor "top right")
	:stacking "bg"
	:exclusive false
	:focusable false
	:windowtype "normal"
	(box
		:class "black-box"
		:orientation "vertical"
		:space-evenly false
		(box
			:class "note-strip"
			(button
				:class "del-btn"
				:onclick "/home/archVaibhav/.config/eww/stickyNotes/close.sh 1"
				"×")
			(box :hexpand true)
			(button
				:class "plus-btn"
				:onclick "/home/archVaibhav/.config/eww/stickyNotes/plus.sh"
				"+"))
		(box 
			:class "note-body"
			:hexpand true
			:vexpand true
			(label
				:text note_1_text
				:wrap true
				:width 40
				:wrap-mode "word"
				:hexpand true
				:xalign 0
				:justify "left"))))

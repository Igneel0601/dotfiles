(defpoll CPU_USAGE :interval "2s" :initial "0" `~/.local/SCRIPTS/eww-sysinfo.sh --cpu`)
(defpoll MEM_USAGE :interval "2s" :initial "0" `~/.local/SCRIPTS/eww-sysinfo.sh --mem`)
(defpoll DISK_USAGE :interval "30s" `~/.local/SCRIPTS/eww-sysinfo.sh --disk`)

(defwidget resources []
  (box :class "res_win" :orientation "h" :space-evenly true :spacing 15
    (box :class "res_box" :orientation "v" :valign "center" :halign "center" :spacing 10 :space-evenly "false"
      (box :class "res_circle" :orientation "v" :valign "center" :halign "center"
        (circular-progress :class "res_cpu" :value CPU_USAGE :thickness 6
          (label :class "res_circle_small" :text "CPU")))
      (label :class "res_text" :text "${CPU_USAGE}%"))
    (box :class "res_box" :orientation "v" :valign "center" :halign "center" :spacing 10 :space-evenly "false"
      (box :class "res_circle" :orientation "v" :valign "center" :halign "center"
        (circular-progress :class "res_mem" :value MEM_USAGE :thickness 6
          (label :class "res_circle_small" :text "MEM")))
      (label :class "res_text" :text "${MEM_USAGE}%"))
    (box :class "res_box" :orientation "v" :valign "center" :halign "center" :spacing 10 :space-evenly "false"
      (box :class "res_circle" :orientation "v" :valign "center" :halign "center"
        (circular-progress :class "res_disk" :value DISK_USAGE :thickness 6
          (label :class "res_circle_small" :text "DISK")))
      (label :class "res_text" :text "${DISK_USAGE}%"))))

(defwindow resources
  :monitor 0
  :geometry (geometry :x "8px" :y "8px" :width "420px" :height "180px" :anchor "top left")
  :stacking "bg"
  :wm-ignore false
  (resources))
